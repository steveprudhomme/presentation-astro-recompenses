\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{beamerfontthemeSwissAstro}[2026/09/11 v0.4.1 SwissAstro font theme]

\RequirePackage[T1]{fontenc}
% TeX Gyre Heros keeps the project self-contained and provides a Helvetica-like
% neo-grotesque voice without shipping commercial font files.
\RequirePackage[scale=0.97]{tgheros}
% Type 1 TeX Gyre Heros is intentionally kept for reproducibility. Normalize a
% few common Unicode characters that are absent from its direct glyph map so
% LuaLaTeX and pdfLaTeX documents can use ordinary French source text safely.
\RequirePackage{newunicodechar}
\newunicodechar{—}{---}
\newunicodechar{–}{--}
\newunicodechar{→}{\ensuremath{\rightarrow}}
\newunicodechar{Œ}{\OE}
\newunicodechar{œ}{\oe}


\mode<presentation>
\usefonttheme{professionalfonts}
\renewcommand{\familydefault}{\sfdefault}

% v0.4.0 formalizes a projection-first type scale. Metadata stays compact but
% no longer drops below the practical floor used by the previous theme.
\setbeamerfont{normal text}{family=\sffamily,size=\fontsize{10.7}{13.4}}
\setbeamerfont{title}{family=\sffamily,series=\bfseries,size=\fontsize{30}{32.5}}
