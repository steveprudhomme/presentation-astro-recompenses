\setbeamerfont{framesubtitle}{family=\sffamily,size=\fontsize{9.8}{11.7}}
\setbeamerfont{section page}{family=\sffamily,series=\bfseries,size=\fontsize{28}{30}}
\setbeamerfont{section number}{family=\sffamily,series=\bfseries,size=\fontsize{46}{46}}
\setbeamerfont{footline}{family=\sffamily,size=\fontsize{6.6}{7.7}}
